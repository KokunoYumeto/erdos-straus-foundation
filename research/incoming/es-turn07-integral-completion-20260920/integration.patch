+def crt(pairs):
+    a=0;n=1
+    for b,m in pairs:
+        if gcd(n,m)!=1:raise ValueError('coprime CRT moduli required')
+        a+=n*((b-a)*pow(n,-1,m)%m);n*=m;a%=n
+    return a,n
