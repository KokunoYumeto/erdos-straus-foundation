+def reciprocal(data,p):
+    roots=data['roots'];D,C,B,_,A=data['coefficients'];N=prod(roots);S=sum(roots)
+    I=pscale([C,B,1,A],-F(p)/D)
+    z=[F(p)/x for x in roots]
