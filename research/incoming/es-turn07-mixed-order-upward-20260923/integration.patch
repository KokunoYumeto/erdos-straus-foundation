+def lucas_tree(numbers):
+    """Construct full n-1 order certificates; leaves are trial-division proofs."""
+    nodes={}
+    def add(n):
+        if n in nodes:return
+        need(n>=2)
+        if n<10000:
+            need(trial_prime(n));nodes[n]=dict(n=n,type='trial',bound=isqrt(n));return
+        f=factor(n-1)
+        for q in f:add(q)
