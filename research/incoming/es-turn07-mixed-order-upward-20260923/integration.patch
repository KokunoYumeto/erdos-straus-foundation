+        if cell['M']%cell['R']:continue
+        rec=state(p,cell['a'],cell['n'],'E')
+        need(rec['full'] and rec['r']==1 and rec['s']==cell['s'])
+        need(Fraction(*rec['quotient'])==cell['M']//cell['R']-1)
+        out.append(dict(cell=cell,state=rec))
+    return out
