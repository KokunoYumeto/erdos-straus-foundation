+    ret['kappa' if tag=='E' else 'lambda']=v
+    require(h*r*s==a and h*r*r==u and gcd(r,s)==1,'target marking')
+    num=a*a*(p if tag=='M' else 1)
+    require(num==u*(R*xyz[1]-p*a),'target ordered inverse')
+    return ret
